PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=poseidon
# Clave para firmar las sesiones. Use un valor largo y aleatorio.
JWT_SECRET=cambie-este-valor
# Contraseña de los usuarios de demostración (Database/usuarios_demo.json).
DEMO_PASSWORD=cambie-esta-clave

# ---------- Respaldos (HU-ADM-03) ----------
# Hora local diaria del respaldo automático (HH:MM). Vacío desactiva los automáticos.
BACKUP_HORA=03:00
# Cuántos respaldos automáticos conservar. Los manuales no se borran solos.
BACKUP_RETENER=14
# Carpeta de los respaldos (por defecto Backend/respaldos). Contiene hashes de contraseñas: protéjala.
# BACKUP_DIR=

# ---------- Alertas climáticas (HU-USR-03) ----------
# Cada cuántas horas se revisan las parcelas con NASA POWER. 0 desactiva la revisión automática.
ALERTAS_CADA_HORAS=6
# Umbrales: mínima diaria (°C) para helada y % de la lluvia normal de 30 días para sequía severa.
ALERTA_HELADA_C=0
ALERTA_SEQUIA_PCT=30
# Notificaciones web (Web Push). Sin claves, se generan y guardan en Backend/.vapid.json.
# Generarlas: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alertas@poseidon.test
# SMS con Twilio. Sin estas variables los SMS se simulan (consola e historial).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+10000000000

# ---------- Fotos de incidencias de campo (HU-OPT-02) ----------
# Las fotos se guardan en una unidad compartida de Google Drive con una cuenta de servicio:
#  1. En Google Cloud: cree una cuenta de servicio, habilite la API de Google Drive y descargue su clave JSON.
#  2. Guarde la clave fuera de git, por ejemplo en Backend/credenciales/drive.json.
#  3. En Google Drive: abra la unidad compartida > Administrar miembros > agregue el correo de la cuenta
#     de servicio (client_email) con el rol "Gestor de contenido".
#  4. Copie el id de la unidad compartida (o de una carpeta dentro de ella) desde la URL:
#     https://drive.google.com/drive/folders/<ESTE_ID>
# Sin estas variables las fotos se guardan en Backend/fotos/ (solo para pruebas) y la interfaz lo avisa.
# GOOGLE_DRIVE_CREDENTIALS=./credenciales/drive.json
# GOOGLE_DRIVE_FOLDER_ID=

# ---------- Datos satelitales por parcela ----------
# Pendiente y elevación con SRTM de la NASA (HU-USR-05). El servicio público por defecto publica SRTM de 30 m
# y admite pocas consultas por segundo; vacío desactiva la consulta.
# ELEVACION_URL=https://api.opentopodata.org/v1/srtm30m
# NDVI de MODIS (MOD13Q1) desde el ORNL DAAC de la NASA (HU-USR-02, HU-MON-04). Tarda decenas de segundos
# por consulta: se pide en segundo plano y se guarda. Vacío lo desactiva.
# NDVI_URL=https://modis.ornl.gov/rst/api/v1/MOD13Q1/subset
# Cuántos años de NDVI guardar por parcela (1 a 8).
NDVI_ANIOS=4

# Traza en consola de cada consulta a NASA POWER, SRTM y MODIS: quién la pidió (usuario y rol),
# si se descargó o salió de caché, el dato recibido y cuánto tardó. 0 la apaga.
TRAZA_NASA=1

# ---------- Capas del GAMC (HU-MON-01) ----------
# Servicio WMS con los límites distritales del municipio. Sin configurar, el tablero lo avisa y sigue funcionando.
# GAMC_WMS_URL=
# GAMC_WMS_CAPAS=
# GAMC_WMS_ATRIBUCION=GAMC
# Para agrupar las parcelas por distrito oficial, copie los polígonos como GeoJSON en Database/distritos.geojson
# (propiedad "nombre" o "distrito"). Sin ese archivo, la zona es el municipio más cercano (aproximado).
# DISTRITOS_GEOJSON=
